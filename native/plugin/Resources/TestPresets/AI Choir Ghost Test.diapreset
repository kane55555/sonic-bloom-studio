{
  "schemaVersion": 2,
  "presetName": "AI Choir Ghost Test",
  "category": "ChoirsVox",
  "sourceInstrument": {
    "type": "multisampleFolder",
    "path": "ChoirsVox/Choir 1",
    "mappingMode": "nearest",
    "rootNotePattern": ["C"]
  },
  "amp": { "gainDb": 0.0, "pan": 0.0, "attackMs": 40.0, "decayMs": 400.0, "sustain": 0.85, "releaseMs": 600.0 },
  "filter": { "enabled": true, "type": "lowpass", "cutoffHz": 16000.0, "resonance": 0.08, "drive": 0.0, "keytrack": 0.0 },
  "ai": {
    "enabled": true,
    "provider": "ddsp",
    "profileVersion": 1,
    "textureMode": "cached",
    "analysisFile": "Samples/AITextures/choir_ghost.ddsp.json",
    "timbreProfile": { "brightness": 0.5, "harmonicDensity": 0.6, "noiseAir": 0.65, "attackNoise": 0.3, "pitchInstability": 0.08, "bodyWarmth": 0.55 }
  },
  "partials": [
    {
      "enabled": true,
      "engineType": "neuralTextureCached",
      "followMainEnvelope": true,
      "eqRole": "neuralTexture",
      "pan": 0.0,
      "pitchSemis": 0,
      "fineCents": 0.0,
      "amp": { "releaseMs": 500.0 },
      "engineParams": {
        "texturePath": "Samples/AITextures/choir_ghost.wav",
        "loop": true,
        "rootMidi": 60,
        "pitchTracking": false,
        "levelDb": -18.0
      }
    }
  ]
}
