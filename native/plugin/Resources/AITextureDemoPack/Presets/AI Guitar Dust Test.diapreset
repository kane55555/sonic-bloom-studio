{
  "schemaVersion": 2,
  "name": "AI Guitar Dust Test",
  "author": "DIDITAGAIN STUDIO / ChatGPT",
  "category": "Guitar",
  "engineType": "hybrid",
  "description": "Real guitar multisample as the main body, enhanced with a subtle cached AI dust/fret-noise texture underneath for movement.",
  "ai": {
    "enabled": true,
    "profileVersion": 1,
    "provider": "cachedTexture",
    "analysisFile": "",
    "textureMode": "cached",
    "timbreProfile": {
      "brightness": 0.58,
      "harmonicDensity": 0.32,
      "noiseAir": 0.42,
      "attackNoise": 0.55,
      "pitchInstability": 0.03,
      "bodyWarmth": 0.35
    },
    "recommendedTexture": "guitar_dust",
    "recommendedTextureAmount": 0.12
  },
  "macros": {
    "tone": 0.56,
    "character": 0.62,
    "width": 0.58,
    "texture": 0.12
  },
  "ampEnvelope": {
    "gainDb": 2,
    "attackMs": 12,
    "decayMs": 180,
    "sustain": 0.82,
    "releaseMs": 220
  },
  "sourceInstrument": {
    "type": "multisampleFolder",
    "path": "{DIDA_DOCS}/Samples/Presets/User/Acoustic Guitars/Acoustic Guitar 1",
    "mappingMode": "nearest",
    "rootNotePattern": ["C"]
  },
  "filter": {
    "type": "lowpass",
    "cutoffHz": 12000,
    "resonance": 0.12,
    "keyTrack": 0.18
  },
  "layerEq": {
    "texture": {
      "hpfHz": 700,
      "lpfHz": 10000,
      "trimDb": -12
    },
    "sample": {
      "hpfHz": 35,
      "lpfHz": 18000,
      "trimDb": 0
    }
  },
  "fx": {
    "chorus": {
      "enabled": true,
      "mix": 0.08
    },
    "reverb": {
      "enabled": true,
      "mix": 0.16,
      "decay": 0.42
    }
  },
  "samples": {
    "rootFolder": "{DIDA_DOCS}/Samples/Presets/User/Acoustic Guitars/Acoustic Guitar 1",
    "required": true,
    "fallbackSynthIfMissing": true,
    "note": "Main sound body = real Guitar multisample. The AI texture only blends on top. If the folder is missing, the optional analog support partial below can be enabled as a fallback."
  },
  "partials": [
    {
      "enabled": false,
      "engineType": "analog",
      "levelDb": 16.0,
      "pan": 0.0,
      "engineParams": {
        "role": "support",
        "osc": "trianglePluck",
        "brightness": 0.48,
        "attackMs": 2,
        "decayMs": 380,
        "releaseMs": 160,
