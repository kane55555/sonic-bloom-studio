      }
    },
    {
      "enabled": true,
      "engineType": "neuralTextureCached",
      "isNeuralTexture": true,
      "levelDb": -20.0,
      "pan": 0.0,
      "pitchSemis": 0,
      "fineCents": 0,
      "followMainEnvelope": true,
      "eqRole": "neuralTexture",
      "engineParams": {
        "texturePath": "{DIDA_DOCS}/NeuralTextures/Demo/GuitarDust/dida_guitar_dust_C4.wav",
        "textureType": "guitar_dust",
        "role": "texture",
        "loop": true,
        "rootMidi": 60,
        "pitchTracking": true,
        "followMainEnvelope": true,
        "sampleRate": 48000,
        "cached": true
      }
    }
  ],
  "qualityExpectations": [
    "AI_TEXTURE_ENABLED",
    "AI_TEXTURE_PARTIAL_PRESENT",
